<?xml version="1.0" encoding="utf-8"?>
<!--
  Compiler and linker settings shared by all otok projects. Imported by each .vcxproj after
  Microsoft.Cpp.props (property sheet), so these values override the toolset defaults.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OtokVcpkgLibDir Condition="'$(Configuration)' == 'Debug'">$(OtokVcpkgInstalled)debug\lib\</OtokVcpkgLibDir>
    <OtokVcpkgLibDir Condition="'$(Configuration)' != 'Debug'">$(OtokVcpkgInstalled)lib\</OtokVcpkgLibDir>
    <!-- Static libraries of vcpkg (debug builds carry a suffix) and the system libraries they need
         (from their .pc files: libcurl with Schannel, libarchive). detours: the sandbox (docs/PLAN.md decision 103), with userenv
         for its AppContainer profile. -->
    <OtokVcpkgLibs Condition="'$(Configuration)' == 'Debug'">libcurl-d.lib;archive.lib;bz2d.lib;lzma.lib;zstd.lib;zsd.lib;$(OtokVcpkgInstalled)lib\detours.lib</OtokVcpkgLibs>
    <OtokVcpkgLibs Condition="'$(Configuration)' != 'Debug'">libcurl.lib;archive.lib;bz2.lib;lzma.lib;zstd.lib;zs.lib;detours.lib</OtokVcpkgLibs>
    <OtokSystemLibs>bcrypt.lib;advapi32.lib;crypt32.lib;secur32.lib;ws2_32.lib;iphlpapi.lib;userenv.lib</OtokSystemLibs>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <!-- Headers included with <...> (vcpkg, standard library) are third-party: no warnings from them. -->
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /Zc:preprocessor /bigobj %(AdditionalOptions)</AdditionalOptions>
      <!-- TOML_HEADER_ONLY=0: vcpkg builds toml++ as a compiled library (tomlplusplus.lib). -->
      <!-- CURL_STATICLIB, LIBARCHIVE_STATIC: their headers would otherwise declare DLL imports. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_SCL_SECURE_NO_WARNINGS;NOMINMAX;WIN32_LEAN_AND_MEAN;TOML_HEADER_ONLY=0;CURL_STATICLIB;LIBARCHIVE_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(OtokRoot)src;$(OtokGeneratedDir);$(OtokRoot)modules\dataforge\include;$(OtokRoot)third_party\lua\src;$(OtokVcpkgInstalled)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OtokVcpkgLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>tomlplusplus.lib;$(OtokVcpkgLibs);$(OtokSystemLibs);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Lib>
      <AdditionalLibraryDirectories>$(OtokVcpkgLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
