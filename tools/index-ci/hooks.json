[
  {
    "id": "otok-view",
    "execute-command": "/home/otok/.local/share/otok-view/run-update.sh",
    "include-command-output-in-response": false,
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "OTOK_VIEW_HOOK_SECRET" | js }}",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": { "source": "header", "name": "X-GitHub-Event" }
          }
        }
      ]
    }
  }
]
