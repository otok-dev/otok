<Project>
  <!--
    build/generated/otok_revision.hpp defines OTOK_REVISION as the output of git describe (always, dirty,
    abbrev 10; an XML comment cannot hold the option names) of this repository. Written only when it changes,
    so a commit recompiles only the files that include it. Generated once per build by otok-core, which
    every other project depends on. CMakeLists.txt generates the same file.
  -->
  <PropertyGroup>
    <!-- git is not always on the PATH that Exec sees; OtokGit can also be set in Directory.Build.local.props. -->
    <!-- ProgramW6432: a 32-bit MSBuild sees "Program Files (x86)" as ProgramFiles. -->
    <OtokGit Condition="'$(OtokGit)' == '' and '$(ProgramW6432)' != '' and Exists('$(ProgramW6432)\Git\cmd\git.exe')">$(ProgramW6432)\Git\cmd\git.exe</OtokGit>
    <OtokGit Condition="'$(OtokGit)' == '' and Exists('$(ProgramFiles)\Git\cmd\git.exe')">$(ProgramFiles)\Git\cmd\git.exe</OtokGit>
    <OtokGit Condition="'$(OtokGit)' == ''">git</OtokGit>
    <!-- The CMake of Visual Studio runs cmake/embed.cmake; OtokCMake can also be set in Directory.Build.local.props. -->
    <OtokCMake Condition="'$(OtokCMake)' == '' and '$(VsInstallRoot)' != '' and Exists('$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</OtokCMake>
    <OtokCMake Condition="'$(OtokCMake)' == ''">cmake</OtokCMake>
  </PropertyGroup>

  <!--
    build/generated/otok_catalog_site.inc holds the files of src/otok/catalog/site/ (templates and assets of the catalog
    site, docs/PLAN.md decision 49), written by cmake/embed.cmake only when they change. CMakeLists.txt generates the same file.
  -->
  <Target Name="OtokCatalogSite" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'otok-core'">
    <MakeDir Directories="$(OtokGeneratedDir)" />
    <Exec Command="&quot;$(OtokCMake)&quot; -DOTOK_EMBED_DIR=$(OtokRoot)src/otok/catalog/site -DOTOK_OUTPUT=$(OtokGeneratedDir)otok_catalog_site.inc -P &quot;$(OtokRoot)cmake/embed.cmake&quot;" />
  </Target>

  <!--
    build/generated/otok_notices.inc holds the license notices of the third-party software built into otok (`otok licenses`,
    cmake/notices.cmake): Lua, dataforge, the catalog's JavaScript libraries and the vcpkg ports of vcpkg_installed.
    CMakeLists.txt generates the same file.
  -->
  <Target Name="OtokNotices" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'otok-core'">
    <MakeDir Directories="$(OtokGeneratedDir)" />
    <Exec Command="&quot;$(OtokCMake)&quot; -DOTOK_ROOT=$(OtokRoot) -DOTOK_VCPKG_SHARE=$(OtokVcpkgInstalled)share -DOTOK_OUTPUT=$(OtokGeneratedDir)otok_notices.inc -P &quot;$(OtokRoot)cmake/notices.cmake&quot;" />
  </Target>

  <Target Name="OtokRevision" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'otok-core'">
    <Exec Command="&quot;$(OtokGit)&quot; describe --always --dirty --abbrev=10" WorkingDirectory="$(OtokRoot)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="OtokRevisionName" />
      <Output TaskParameter="ExitCode" PropertyName="OtokRevisionExitCode" />
    </Exec>
    <PropertyGroup>
      <OtokRevisionName Condition="'$(OtokRevisionExitCode)' != '0' or '$(OtokRevisionName)' == ''">unknown</OtokRevisionName>
    </PropertyGroup>
    <MakeDir Directories="$(OtokGeneratedDir)" />
    <WriteLinesToFile File="$(OtokGeneratedDir)otok_revision.hpp" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// generated by Directory.Build.targets, not in git;#pragma once;#define OTOK_REVISION &quot;$(OtokRevisionName)&quot;" />
  </Target>
</Project>
