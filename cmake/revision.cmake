#
# Writes OTOK_OUTPUT with OTOK_REVISION = `git describe --always --dirty --abbrev=10` of OTOK_ROOT,
# or "unknown" without git. OTOK_REVISION_OVERRIDE, when set, is used instead (builds from a source archive
# without .git, e.g. build-macos-remote). The file is rewritten only when its content changes.

# git is not always on PATH on Windows; look at the default install location too.
find_program(GIT_EXECUTABLE git HINTS "$ENV{ProgramW6432}/Git/cmd" "$ENV{ProgramFiles}/Git/cmd")
find_package(Git QUIET)
set(revision "unknown")
if(DEFINED OTOK_REVISION_OVERRIDE AND NOT OTOK_REVISION_OVERRIDE STREQUAL "")
    set(revision ${OTOK_REVISION_OVERRIDE})
elseif(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} describe --always --dirty --abbrev=10
        WORKING_DIRECTORY ${OTOK_ROOT}
        OUTPUT_VARIABLE git_revision
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE git_result
        ERROR_QUIET)
    if(git_result EQUAL 0 AND NOT git_revision STREQUAL "")
        set(revision ${git_revision})
    endif()
endif()

set(content "// generated by cmake/revision.cmake, not in git\n#pragma once\n#define OTOK_REVISION \"${revision}\"\n")
if(EXISTS ${OTOK_OUTPUT})
    file(READ ${OTOK_OUTPUT} existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE ${OTOK_OUTPUT} "${content}")
endif()
