#
# Writes OTOK_OUTPUT, a C++ fragment holding every file under OTOK_EMBED_DIR as a char array and the table
# `embedded_files` of { path relative to OTOK_EMBED_DIR, contents } sorted by path (docs/PLAN.md decision 49).
# CR LF becomes LF, so a checkout with CRLF line endings embeds the same bytes. The file is rewritten only
# when its content changes. Both builds run it: CMakeLists.txt and Directory.Build.targets.

file(TO_CMAKE_PATH "${OTOK_EMBED_DIR}" OTOK_EMBED_DIR)
file(GLOB_RECURSE files RELATIVE ${OTOK_EMBED_DIR} ${OTOK_EMBED_DIR}/*)
list(SORT files)

set(content "// generated by cmake/embed.cmake, not in git\n")
set(table "")
set(index 0)
foreach(file IN LISTS files)
    file(READ ${OTOK_EMBED_DIR}/${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
    string(REPLACE "'\\x0d','\\x0a'," "'\\x0a'," bytes "${bytes}")
    # a line break every 32 bytes
    string(REGEX REPLACE "(('[^']+',){32})" "\\1\n" bytes "${bytes}")
    string(APPEND content "constexpr char embedded_${index}[] = {\n${bytes}'\\0'};\n")
    string(APPEND table "    {\"${file}\", std::string_view{embedded_${index}, sizeof embedded_${index} - 1}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "constexpr embedded_file embedded_files[] = {\n${table}};\n")

if(EXISTS ${OTOK_OUTPUT})
    file(READ ${OTOK_OUTPUT} existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE ${OTOK_OUTPUT} "${content}")
endif()
